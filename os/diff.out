+    if !start_va.aligned() {
+        return -1;
+    }
+    let current_task = current_task().unwrap();
+    let mut inner = current_task.inner_exclusive_access();
+    let ret = inner.memory_set.delete_framed_area(start_va, end_va);
+    drop(inner);
+    ret
 }
 
