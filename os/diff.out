diff --git a/os/src/task/priority.rs b/os/src/task/priority.rs
new file mode 100644
index 0000000..f43221a
--- /dev/null
+++ b/os/src/task/priority.rs
@@ -0,0 +1,24 @@
+
+const BIGSTRIDE: usize = 1600000;
+pub struct TaskPriority {
+    prio: usize,
+    stride: usize,
+}
+
+impl TaskPriority {
+    pub fn new() -> Self {
+        Self {
+            prio: 16,
+            stride: 0,
+        }
+    }
+    pub fn set_prio(&mut self, prio: usize) {
+        self.prio = prio;
+    }
+    pub fn step_one(&mut self) {
+        self.stride += BIGSTRIDE / self.prio;
+    }
+    pub fn get_stride(&self) -> usize {
+        self.stride
+    }
+}
